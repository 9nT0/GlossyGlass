name: Build iOS dylib

on:
  workflow_dispatch:
  push:
    branches: [main, master]

jobs:
  build:
    runs-on: macos-14
    steps:
      - uses: actions/checkout@v4

      - name: Select Xcode
        run: sudo xcode-select -s /Applications/Xcode.app

      - name: Build GlossyGlass dylib
        shell: bash
        run: |
          set -euo pipefail
          echo "Xcode = $(xcodebuild -version | head -1)"

          # Collect all source files
          SOURCES=$(find . -name "*.swift" -o -name "*.m" | grep -v Package.swift | sort)
          echo "Sources:"
          echo "$SOURCES"

          mkdir -p GlossyGlass.xcodeproj

          # Generate a simple project that compiles everything as a dylib
          cat > build.sh << 'BUILD'
          #!/bin/bash
          set -euo pipefail
          SDK=$(xcrun --sdk iphoneos --show-sdk-path)
          OUT=GlossyGlass.dylib
          SWIFT_FILES=$(find . -name "*.swift" | grep -v Package.swift | tr '\n' ' ')
          OBJC_FILES=$(find . -name "*.m" | tr '\n' ' ')

          # Compile Swift
          xcrun -sdk iphoneos swiftc \
            -emit-library \
            -o "$OUT" \
            -target arm64-apple-ios16.0 \
            -sdk "$SDK" \
            -module-name GlossyGlass \
            -parse-as-library \
            -O \
            -framework UIKit \
            -framework Foundation \
            $SWIFT_FILES $OBJC_FILES \
            -import-objc-header /dev/null 2>/dev/null || true

          # Fallback: compile with clang + swiftc separately if needed
          if [ ! -f "$OUT" ]; then
            echo "Trying alternative build..."
            mkdir -p build
            xcrun -sdk iphoneos swiftc \
              -c -parse-as-library \
              -target arm64-apple-ios16.0 \
              -sdk "$SDK" \
              -module-name GlossyGlass \
              -O \
              $SWIFT_FILES \
              -o build/swift.o || true

            if [ -n "$OBJC_FILES" ]; then
              xcrun -sdk iphoneos clang \
                -c \
                -target arm64-apple-ios16.0 \
                -isysroot "$SDK" \
                -fobjc-arc \
                $OBJC_FILES \
                -o build/objc.o || true
            fi

            xcrun -sdk iphoneos clang \
              -target arm64-apple-ios16.0 \
              -isysroot "$SDK" \
              -dynamiclib \
              -o "$OUT" \
              build/*.o \
              -framework UIKit \
              -framework Foundation \
              -lswiftCore -lswiftFoundation -lswiftUIKit \
              -L$(xcrun -sdk iphoneos --show-sdk-path)/../../../../../Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/iphoneos \
              2>/dev/null || true
          fi

          if [ -f "$OUT" ]; then
            echo "Built successfully: $OUT"
            ls -la "$OUT"
            file "$OUT"
          else
            echo "Build produced no dylib — listing files"
            find . -type f | head -40
            exit 1
          fi
          BUILD
          chmod +x build.sh
          ./build.sh

      - uses: actions/upload-artifact@v4
        with:
          name: GlossyGlass-dylib
          path: GlossyGlass.dylib
